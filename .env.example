# ---------------------------------------------------------------------------
# JobPilot configuration. Copy to `.env` and fill in what you need.
# Everything is optional: JobPilot runs fully local with no API key.
# ---------------------------------------------------------------------------

# --- Flask ----------------------------------------------------------------
# Use a long random value anywhere the app is reachable by anyone else.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
HOST=127.0.0.1
PORT=5000

# --- Storage --------------------------------------------------------------
# Relative paths resolve from the directory where the process starts.
DATA_DIR=data
TRACE_DIR=traces
DB_NAME=jobpilot.sqlite3

# --- LLM gateway (OpenAI-compatible) --------------------------------------
# Leave OPENAI_API_KEY blank to use the deterministic local planner.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JOBS_FAST_MODEL=gpt-4o-mini
JOBS_STRONG_MODEL=gpt-4o-mini

# local = deterministic hashing embeddings (no key, no cost)
# openai = provider embeddings through the gateway
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Hard cost guardrails (USD) -------------------------------------------
# The gateway refuses calls that would cross these limits.
MAX_BUDGET_USD=1.50
DAILY_BUDGET_USD=0.50
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- Harness limits -------------------------------------------------------
MAX_STEPS=12
MAX_CONSECUTIVE_FAILURES=3
CONTEXT_TOKEN_BUDGET=6000

# --- Job sources ----------------------------------------------------------
# Greenhouse and Workable are free public ATS APIs. No key is required.
# Board tokens look like the path in boards.greenhouse.io/<token>.
ENABLE_GREENHOUSE=1
GREENHOUSE_BOARDS=figma,vercel,gitlab,dropbox

# Workable account slugs look like apply.workable.com/<slug>.
ENABLE_WORKABLE=1
WORKABLE_ACCOUNTS=devsinc-17,userwise-services,prime-system

# Indeed retired its public search API and prohibits scraping. Keep disabled.
ENABLE_INDEED=0

# Adzuna is optional and requires a free API key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# RSS feeds are comma-separated.
ENABLE_RSS_SOURCES=1
RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss

# LinkedIn automation may violate its Terms of Service. Keep this off.
ENABLE_LINKEDIN=0

# --- Key-free public boards -----------------------------------------------
# Mustakbil (Pakistan), Himalayas, The Muse and Jobicy need no key. Turn any
# one off to narrow the result set or skip a source that is slow from your
# network; the search report then lists it as disabled.
ENABLE_MUSTAKBIL=1
ENABLE_HIMALAYAS=1
ENABLE_THEMUSE=1
ENABLE_JOBICY=1

# --- Search behaviour -----------------------------------------------------
# Per-request HTTP timeout and the wall-clock budget for one live search.
# A source that has not answered inside the budget is reported as `timeout`
# instead of holding the whole search open.
HTTP_TIMEOUT_SECONDS=20
SOURCE_BUDGET_SECONDS=45
# Repeat searches inside this window are served from an in-process cache;
# pages are sliced from the cached ranked list, so paging never re-fetches.
SEARCH_CACHE_TTL_SECONDS=300

# --- Resumes --------------------------------------------------------------
# Maximum size of an uploaded PDF/DOCX/TXT/MD resume.
MAX_RESUME_MB=10

# --- CLI / MCP workspace --------------------------------------------------
# Headless commands act as this account. The web UI ignores these and uses the
# signed-in session. Leave blank to use the legacy `local` workspace.
JOBPILOT_USER_EMAIL=
JOBPILOT_USER_ID=
